<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base del arranque (luego Compose toma el control) -->
    <style name="Tema.Aguacero" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#2E7CD6</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Splash al abrir la app: fondo azul primario con el logo de Aguacero -->
    <style name="Tema.Aguacero.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1786B4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_aguacero</item>
        <item name="postSplashScreenTheme">@style/Tema.Aguacero</item>
    </style>
</resources>
