---
import type { Categoria, Evento } from '../lib/supabase';

interface Props {
  categorias: Categoria[];
  evento?: Evento | null;
}

const { categorias, evento = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const e = evento ?? ({} as Partial<Evento>);
const fechasEvento = e.fechas && e.fechas.length ? e.fechas : [e.fecha ?? ''];
const nombresPasos = ['Info básica', 'Fechas y horarios', 'Lugar y contactos', 'Imagen', 'Revisar'];
const campo = 'w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero';
const etiqueta = 'block text-sm font-medium text-slate-700 mb-1';
---
<!-- Clases dinámicas del wizard (para que Tailwind las incluya): bg-aguacero border-aguacero bg-emerald-500 border-emerald-500 text-white text-slate-500 -->
<form id="form-evento" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5 max-w-2xl">
  <!-- Indicador de pasos -->
  <div class="flex flex-wrap gap-2">
    {nombresPasos.map((nombre, i) => (
      <button type="button" data-ind={i + 1}
        class="wiz-ind rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-500 transition-colors cursor-pointer">
        {i + 1}. {nombre}
      </button>
    ))}
  </div>

  <!-- PASO 1: Info básica -->
  <section class="wiz-paso space-y-4" data-paso="1">
    <div>
      <label class={etiqueta}>Título *</label>
      <input name="titulo" required value={e.titulo ?? ''} placeholder="Nombre del evento" class={campo} />
    </div>
    <div>
      <label class={etiqueta}>Descripción</label>
      <textarea name="descripcion" rows="4" placeholder="Detalles del evento…"
        class={campo}>{e.descripcion ?? ''}</textarea>
    </div>
    <div>
      <label class={etiqueta}>Categoría</label>
      <select name="categoria_id" class={campo}>
        <option value="">Sin categoría</option>
        {categorias.map((c) => (
          <option value={c.id} selected={e.categoria_id === c.id}>{c.emoji} {c.nombre}</option>
        ))}
      </select>
    </div>
    <label class="flex items-center gap-2 cursor-pointer select-none">
      <input name="destacado" type="checkbox" checked={e.destacado ?? false} class="w-4 h-4 accent-aguacero" />
      <span class="text-sm font-medium text-slate-700">⭐ Evento destacado</span>
    </label>
  </section>

  <!-- PASO 2: Fechas y horarios -->
  <section class="wiz-paso space-y-4" data-paso="2" style="display:none">
    <div>
      <label class={etiqueta}>Fecha(s) del evento *</label>
      <div id="lista-fechas" class="space-y-2">
        {fechasEvento.map((f) => (
          <div class="fila-fecha flex items-center gap-2">
            <input type="date" name="fechas" value={f}
              class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            <button type="button" class="btn-quitar-fecha rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-500 hover:bg-red-50 hover:text-red-600" title="Quitar fecha">✕</button>
          </div>
        ))}
      </div>
      <button type="button" id="btn-add-fecha"
        class="mt-2 rounded-xl border border-dashed border-slate-300 px-4 py-2 text-sm text-slate-600 hover:border-aguacero hover:text-aguacero transition-colors">
        ＋ Agregar otra fecha
      </button>
      <p class="text-xs text-slate-400 mt-1">Un evento puede tener varias fechas (ej: función viernes, sábado y domingo).</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class={etiqueta}>Hora de inicio *</label>
        <input name="hora" type="time" required value={e.hora?.slice(0, 5) ?? ''} class={campo} />
      </div>
      <div>
        <label class={etiqueta}>Hora de fin</label>
        <input name="hora_fin" type="time" value={e.hora_fin?.slice(0, 5) ?? ''} class={campo} />
      </div>
      <div>
        <label class={etiqueta}>Apertura de puertas</label>
        <input name="hora_apertura" type="time" value={e.hora_apertura?.slice(0, 5) ?? ''} class={campo} />
      </div>
    </div>
  </section>

  <!-- PASO 3: Lugar y contactos -->
  <section class="wiz-paso space-y-4" data-paso="3" style="display:none">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class={etiqueta}>Lugar *</label>
        <input name="lugar" required value={e.lugar ?? ''} placeholder="Ej: Teatro Karl Marx" class={campo} />
      </div>
      <div>
        <label class={etiqueta}>Dirección</label>
        <input name="direccion" value={e.direccion ?? ''} placeholder="Calle y número" class={campo} />
      </div>
      <div>
        <label class={etiqueta}>Precio</label>
        <input name="precio" value={e.precio ?? ''} placeholder="Ej: 500 CUP / Gratis" class={campo} />
      </div>
      <div>
        <label class={etiqueta}>Organizador</label>
        <input name="organizador" value={e.organizador ?? ''} placeholder="Quién organiza" class={campo} />
      </div>
      <div>
        <label class={etiqueta}>Contacto (teléfonos, uno por línea)</label>
        <textarea name="contacto" rows="2" placeholder="+53 5xxxxxxx"
          class={campo}>{(e.contacto ?? []).join('\n')}</textarea>
      </div>
      <div>
        <label class={etiqueta}>Correo de contacto</label>
        <input name="correo" type="email" value={e.correo ?? ''} placeholder="organizador@ejemplo.cu" class={campo} />
      </div>
      <div class="md:col-span-2">
        <label class={etiqueta}>Link web</label>
        <input name="link_web" type="url" value={e.link_web ?? ''} placeholder="https://…" class={campo} />
      </div>
    </div>
  </section>

  <!-- PASO 4: Imagen -->
  <section class="wiz-paso space-y-4" data-paso="4" style="display:none">
    <div>
      <label class={etiqueta}>Imagen del flyer</label>
      <div class="flex flex-col sm:flex-row gap-3">
        <label class="flex-1 cursor-pointer">
          <input id="input-archivo" type="file" accept="image/*" class="hidden" />
          <span class="flex items-center justify-center gap-2 w-full rounded-xl border-2 border-dashed border-slate-300 hover:border-aguacero px-4 py-3 text-sm text-slate-600 hover:text-aguacero transition-colors">
            📤 <span id="nombre-archivo">Subir imagen…</span>
          </span>
        </label>
        <input name="imagen" id="input-url" type="url" value={e.imagen ?? ''} placeholder="…o pega una URL https://"
          class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
      </div>
      <div id="preview-img" class="mt-2" style={e.imagen ? '' : 'display:none'}>
        <img src={e.imagen ?? ''} class="h-24 rounded-xl object-cover border border-slate-200" alt="Vista previa" />
      </div>
      <p id="estado-subida" class="text-xs text-slate-500 mt-1"></p>
    </div>
  </section>

  <!-- PASO 5: Revisar -->
  <section class="wiz-paso space-y-4" data-paso="5" style="display:none">
    <div id="resumen" class="rounded-xl bg-slate-50 border border-slate-200 p-4"></div>
    <p class="text-xs text-slate-400">Revisa los datos antes de guardar. Puedes volver a cualquier paso tocando su número.</p>
  </section>

  <!-- Navegación del wizard -->
  <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-slate-100">
    <button type="button" id="btn-anterior"
      class="rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-50 text-slate-700">
      ← Atrás
    </button>
    <button type="button" id="btn-siguiente"
      class="rounded-xl bg-aguacero hover:bg-aguacero-oscuro text-white font-semibold px-6 py-2.5 text-sm transition-colors">
      Siguiente →
    </button>
    <button type="submit" id="btn-guardar" style="display:none"
      class="rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-2.5 text-sm transition-colors">
      💾 Guardar
    </button>
    <a href={`${base}/`}
      class="rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-50 text-slate-700">
      Cancelar
    </a>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { inicializarWizard } from '../lib/wizard';

    const form = document.getElementById('form-evento') as HTMLFormElement;
    inicializarWizard(form);

    // ---- Subida de imagen a Supabase Storage ----
    const inputArchivo = document.getElementById('input-archivo') as HTMLInputElement;
    const inputUrl = document.getElementById('input-url') as HTMLInputElement;
    const nombreArchivo = document.getElementById('nombre-archivo') as HTMLElement;
    const preview = document.getElementById('preview-img') as HTMLElement;
    const estado = document.getElementById('estado-subida') as HTMLElement;

    inputUrl?.addEventListener('input', () => {
      const img = preview.querySelector('img') as HTMLImageElement;
      if (inputUrl.value) { img.src = inputUrl.value; preview.style.display = ''; }
      else preview.style.display = 'none';
    });

    inputArchivo?.addEventListener('change', async () => {
      const archivo = inputArchivo.files?.[0];
      if (!archivo) return;
      nombreArchivo.textContent = archivo.name;
      estado.textContent = '⏳ Subiendo…';
      estado.className = 'text-xs text-amber-600 mt-1';
      try {
        const ext = archivo.name.split('.').pop() || 'jpg';
        const nombre = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
        const { error } = await supabase.storage.from('flyers').upload(nombre, archivo, {
          contentType: archivo.type,
        });
        if (error) throw error;
        const { data } = supabase.storage.from('flyers').getPublicUrl(nombre);
        inputUrl.value = data.publicUrl;
        const img = preview.querySelector('img') as HTMLImageElement;
        img.src = data.publicUrl;
        preview.style.display = '';
        estado.textContent = '✓ Imagen subida';
        estado.className = 'text-xs text-emerald-600 mt-1';
      } catch (err: any) {
        estado.textContent = '✗ Error: ' + (err.message ?? err);
        estado.className = 'text-xs text-red-600 mt-1';
      }
    });
  </script>
</form>
