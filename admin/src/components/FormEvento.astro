---
import type { Categoria, Evento } from '../lib/supabase';

interface Props {
  categorias: Categoria[];
  evento?: Evento | null;
}

const { categorias, evento = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const e = evento ?? ({} as Partial<Evento>);
---
<form id="form-evento" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5 max-w-2xl">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-slate-700 mb-1">Título *</label>
      <input name="titulo" required value={e.titulo ?? ''} placeholder="Nombre del evento"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-slate-700 mb-1">Descripción</label>
      <textarea name="descripcion" rows="3" placeholder="Detalles del evento…"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero">{e.descripcion ?? ''}</textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Fecha *</label>
      <input name="fecha" type="date" required value={e.fecha ?? ''}
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Hora *</label>
      <input name="hora" type="time" required value={e.hora?.slice(0, 5) ?? ''}
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Apertura de puertas</label>
      <input name="hora_apertura" type="time" value={e.hora_apertura?.slice(0, 5) ?? ''}
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Categoría</label>
      <select name="categoria_id"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero">
        <option value="">Sin categoría</option>
        {categorias.map((c) => (
          <option value={c.id} selected={e.categoria_id === c.id}>{c.emoji} {c.nombre}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Lugar *</label>
      <input name="lugar" required value={e.lugar ?? ''} placeholder="Ej: Teatro Karl Marx"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Dirección</label>
      <input name="direccion" value={e.direccion ?? ''} placeholder="Calle y número"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Precio</label>
      <input name="precio" value={e.precio ?? ''} placeholder="Ej: 500 CUP / Gratis"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Organizador</label>
      <input name="organizador" value={e.organizador ?? ''} placeholder="Quién organiza"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Contacto (teléfonos, uno por línea)</label>
      <textarea name="contacto" rows="2" placeholder="+53 5xxxxxxx"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero">{(e.contacto ?? []).join('\n')}</textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Link web</label>
      <input name="link_web" type="url" value={e.link_web ?? ''} placeholder="https://…"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-slate-700 mb-1">Imagen (URL del flyer)</label>
      <input name="imagen" type="url" value={e.imagen ?? ''} placeholder="https://…"
        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
    </div>
    <div class="md:col-span-2">
      <label class="flex items-center gap-2 cursor-pointer select-none">
        <input name="destacado" type="checkbox" checked={e.destacado ?? false} class="w-4 h-4 accent-aguacero" />
        <span class="text-sm font-medium text-slate-700">⭐ Evento destacado</span>
      </label>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <button type="submit" id="btn-guardar"
      class="rounded-xl bg-aguacero hover:bg-aguacero-oscuro text-white font-semibold px-6 py-2.5 text-sm transition-colors">
      💾 Guardar
    </button>
    <a href={`${base}/`}
      class="rounded-xl border border-slate-300 px-6 py-2.5 text-sm font-medium hover:bg-slate-50 text-slate-700">
      Cancelar
    </a>
  </div>
</form>
