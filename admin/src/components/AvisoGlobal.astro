---
// Toast global: escucha el evento 'aguacero-aviso' emitido por las librerías.
---
<div id="toast" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 hidden" role="status" aria-live="polite"></div>
<script>
  type Tipo = 'exito' | 'error' | 'info';
  const clases: Record<Tipo, string> = {
    exito: 'bg-emerald-600 text-white',
    error: 'bg-red-600 text-white',
    info: 'bg-slate-800 text-white',
  };
  let temporizador = 0;
  window.addEventListener('aguacero-aviso', (suceso) => {
    const { texto, tipo } = (suceso as CustomEvent<{ texto: string; tipo: Tipo }>).detail;
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = texto;
    toast.className = `fixed bottom-4 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-medium ${clases[tipo]}`;
    clearTimeout(temporizador);
    if (tipo !== 'info') {
      temporizador = window.setTimeout(() => toast.classList.add('hidden'), 3500);
    }
  });
</script>
