---
import '../styles.css';

interface Props {
  titulo: string;
  mostrarNav?: boolean;
}

const { titulo, mostrarNav = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · Aguacero Admin</title>
</head>
<body class="min-h-screen">
  {mostrarNav && (
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href={`${base}/`} class="flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-aguacero flex items-center justify-center text-white text-xl">🌧️</span>
          <span class="font-bold text-lg text-aguacero-muy-oscuro">Aguacero <span class="font-normal text-slate-500 text-sm">admin</span></span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href={`${base}/`} class="px-3 py-2 rounded-lg hover:bg-aguacero-suave text-slate-700 font-medium">Eventos</a>
          <a href={`${base}/categorias`} class="px-3 py-2 rounded-lg hover:bg-aguacero-suave text-slate-700 font-medium">Categorías</a>
          <button id="btn-salir" class="px-3 py-2 rounded-lg text-red-600 hover:bg-red-50 font-medium">Salir</button>
        </nav>
      </div>
    </header>
  )}

  <main class="max-w-5xl mx-auto px-4 py-6">
    <slot />
  </main>

  <div id="toast" class="fixed bottom-4 right-4 hidden px-4 py-3 rounded-xl shadow-lg text-sm font-medium z-50"></div>

  <script>
    import { supabase } from '../lib/supabase';

    // Toast global
    (window as any).toast = (msg: string, tipo: 'ok' | 'error' = 'ok') => {
      const el = document.getElementById('toast')!;
      el.textContent = msg;
      el.className = `fixed bottom-4 right-4 px-4 py-3 rounded-xl shadow-lg text-sm font-medium z-50 ${tipo === 'ok' ? 'bg-green-600 text-white' : 'bg-red-600 text-white'}`;
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 3000);
    };

    // Salir
    document.getElementById('btn-salir')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      window.location.href = `${base}/login`;
    });

    // Proteger páginas (excepto login)
    const esLogin = window.location.pathname.endsWith('/login') || window.location.pathname.endsWith('/login/');
    if (esLogin === false) {
      supabase.auth.getSession().then(({ data }) => {
        if (!data.session) {
          const base = import.meta.env.BASE_URL.replace(/\/$/, '');
          window.location.href = `${base}/login`;
        }
      });
    }
  </script>
</body>
</html>
