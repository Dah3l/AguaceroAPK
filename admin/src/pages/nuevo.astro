---
import Base from '../layouts/Base.astro';
import FormEvento from '../components/FormEvento.astro';
import { supabase } from '../lib/supabase';

const { data: categorias } = await supabase.from('categorias').select('*').order('nombre');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titulo="Nuevo evento">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">＋ Nuevo evento</h1>
  <FormEvento categorias={categorias ?? []} />

  <script>
    import { supabase, nuevoId } from '../lib/supabase';

    document.getElementById('form-evento')?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const form = ev.target as HTMLFormElement;
      const fd = new FormData(form);
      const btn = document.getElementById('btn-guardar') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Guardando…';

      const contactoRaw = (fd.get('contacto') as string ?? '').split('\n').map((s) => s.trim()).filter(Boolean);
      const fechasRaw = fd.getAll('fechas').map((s) => (s as string).trim()).filter(Boolean).sort();

      const { error } = await supabase.from('eventos').insert({
        id: nuevoId(),
        titulo: fd.get('titulo'),
        descripcion: fd.get('descripcion') || '',
        fecha: fechasRaw[0],
        fechas: fechasRaw,
        hora: fd.get('hora'),
        hora_fin: (fd.get('hora_fin') as string) || null,
        hora_apertura: (fd.get('hora_apertura') as string) || null,
        lugar: fd.get('lugar'),
        direccion: fd.get('direccion') || '',
        precio: fd.get('precio') || '',
        contacto: contactoRaw,
        correo: (fd.get('correo') as string) || null,
        link_web: (fd.get('link_web') as string) || null,
        imagen: fd.get('imagen') || '',
        categoria_id: (fd.get('categoria_id') as string) || null,
        organizador: fd.get('organizador') || '',
        destacado: (form.querySelector('[name="destacado"]') as HTMLInputElement).checked,
        publicado: false,
      });

      if (error) {
        (window as any).toast('Error al guardar: ' + error.message, 'error');
        btn.disabled = false;
        btn.textContent = '💾 Guardar';
      } else {
        (window as any).toast('📝 Borrador guardado');
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        setTimeout(() => (window.location.href = `${base}/`), 800);
      }
    });
  </script>
</Base>
