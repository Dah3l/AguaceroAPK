---
import Base from '../layouts/Base.astro';
import FormEvento from '../components/FormEvento.astro';
import { supabase } from '../lib/supabase';

const { data: categorias } = await supabase.from('categorias').select('*').order('nombre');
---
<Base titulo="Editar evento">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">✏️ Editar evento</h1>
  <div id="contenedor"><p class="text-slate-500">Cargando…</p></div>

  <script>
    import { supabase, type Evento, type Categoria } from '../lib/supabase';

    const id = new URLSearchParams(window.location.search).get('id');
    const cont = document.getElementById('contenedor')!;

    if (!id) {
      cont.innerHTML = '<p class="text-red-600">Falta el identificador del evento.</p>';
    } else {
      const [{ data: ev }, { data: cats }] = await Promise.all([
        supabase.from('eventos').select('*').eq('id', id).single(),
        supabase.from('categorias').select('*').order('nombre'),
      ]);

      if (!ev) {
        cont.innerHTML = '<p class="text-red-600">No se encontró el evento.</p>';
      } else {
        // Renderizar el formulario con los datos (vía template manual)
        const e = ev as Evento;
        const categorias = (cats ?? []) as Categoria[];
        const opts = categorias.map((c) =>
          `<option value="${c.id}" ${e.categoria_id === c.id ? 'selected' : ''}>${c.emoji} ${c.nombre}</option>`
        ).join('');

        cont.innerHTML = `
        <form id="form-evento" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5 max-w-2xl">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">Título *</label>
              <input name="titulo" required value="${e.titulo.replace(/"/g, '&quot;')}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">Descripción</label>
              <textarea name="descripcion" rows="3"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero">${e.descripcion ?? ''}</textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Fecha *</label>
              <input name="fecha" type="date" required value="${e.fecha}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Hora *</label>
              <input name="hora" type="time" required value="${(e.hora ?? '').slice(0, 5)}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Apertura</label>
              <input name="hora_apertura" type="time" value="${(e.hora_apertura ?? '').slice(0, 5)}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Categoría</label>
              <select name="categoria_id"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero">
                <option value="">Sin categoría</option>${opts}
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Lugar *</label>
              <input name="lugar" required value="${(e.lugar ?? '').replace(/"/g, '&quot;')}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Dirección</label>
              <input name="direccion" value="${(e.direccion ?? '').replace(/"/g, '&quot;')}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Precio</label>
              <input name="precio" value="${(e.precio ?? '').replace(/"/g, '&quot;')}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Organizador</label>
              <input name="organizador" value="${(e.organizador ?? '').replace(/"/g, '&quot;')}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Contacto (uno por línea)</label>
              <textarea name="contacto" rows="2"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero">${(e.contacto ?? []).join('\n')}</textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Link web</label>
              <input name="link_web" type="url" value="${e.link_web ?? ''}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">Imagen (URL)</label>
              <input name="imagen" type="url" value="${e.imagen ?? ''}"
                class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
            </div>
            <div class="md:col-span-2 flex flex-wrap gap-6">
              <label class="flex items-center gap-2 cursor-pointer">
                <input name="destacado" type="checkbox" ${e.destacado ? 'checked' : ''} class="w-4 h-4 accent-aguacero" />
                <span class="text-sm font-medium text-slate-700">⭐ Evento destacado</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input name="publicado" type="checkbox" ${e.publicado ? 'checked' : ''} class="w-4 h-4 accent-emerald-500" />
                <span class="text-sm font-medium text-slate-700">🚀 Publicado <span class="text-xs text-slate-400">(visible en la APK)</span></span>
              </label>
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" id="btn-guardar"
              class="rounded-xl bg-aguacero hover:bg-aguacero-oscuro text-white font-semibold px-6 py-2.5 text-sm">💾 Guardar</button>
          </div>
        </form>`;

        document.getElementById('form-evento')?.addEventListener('submit', async (ev2) => {
          ev2.preventDefault();
          const form = ev2.target as HTMLFormElement;
          const fd = new FormData(form);
          const btn = document.getElementById('btn-guardar') as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = 'Guardando…';
          const contactoRaw = ((fd.get('contacto') as string) ?? '').split('\n').map((s) => s.trim()).filter(Boolean);

          const { error } = await supabase.from('eventos').update({
            titulo: fd.get('titulo'),
            descripcion: fd.get('descripcion') || '',
            fecha: fd.get('fecha'),
            hora: fd.get('hora'),
            hora_apertura: ((fd.get('hora_apertura') as string) || null) as any,
            lugar: fd.get('lugar'),
            direccion: fd.get('direccion') || '',
            precio: fd.get('precio') || '',
            contacto: contactoRaw,
            link_web: ((fd.get('link_web') as string) || null) as any,
            imagen: fd.get('imagen') || '',
            categoria_id: ((fd.get('categoria_id') as string) || null) as any,
            organizador: fd.get('organizador') || '',
            destacado: (form.querySelector('[name="destacado"]') as HTMLInputElement).checked,
            publicado: (form.querySelector('[name="publicado"]') as HTMLInputElement).checked,
          }).eq('id', id);

          if (error) {
            (window as any).toast('Error: ' + error.message, 'error');
            btn.disabled = false;
            btn.textContent = '💾 Guardar';
          } else {
            (window as any).toast('Evento actualizado ✓');
            const base = import.meta.env.BASE_URL.replace(/\/$/, '');
            setTimeout(() => (window.location.href = `${base}/`), 800);
          }
        });
      }
    }
  </script>
</Base>
