---
import Base from '../layouts/Base.astro';
---
<Base titulo="Editar evento">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">✏️ Editar evento</h1>
  <div id="contenedor"><p class="text-slate-500">Cargando…</p></div>

  <script>
    import { supabase, type Evento, type Categoria } from '../lib/supabase';
    import { inicializarWizard } from '../lib/wizard';

    const id = new URLSearchParams(window.location.search).get('id');
    const cont = document.getElementById('contenedor')!;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const campo = 'w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero';
    const etiqueta = 'block text-sm font-medium text-slate-700 mb-1';
    const esc = (s: string) => (s ?? '').replace(/"/g, '&quot;');

    if (!id) {
      cont.innerHTML = '<p class="text-red-600">Falta el identificador del evento.</p>';
    } else {
      const [{ data: ev }, { data: cats }] = await Promise.all([
        supabase.from('eventos').select('*').eq('id', id).single(),
        supabase.from('categorias').select('*').order('nombre'),
      ]);

      if (!ev) {
        cont.innerHTML = '<p class="text-red-600">No se encontró el evento.</p>';
      } else {
        const e = ev as Evento;
        const categorias = (cats ?? []) as Categoria[];
        const opts = categorias.map((c) =>
          `<option value="${c.id}" ${e.categoria_id === c.id ? 'selected' : ''}>${c.emoji} ${c.nombre}</option>`
        ).join('');
        const nombresPasos = ['Info básica', 'Fechas y horarios', 'Lugar y contactos', 'Imagen', 'Revisar'];
        const indicador = nombresPasos.map((n, i) =>
          `<button type="button" data-ind="${i + 1}" class="wiz-ind rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-500 transition-colors cursor-pointer">${i + 1}. ${n}</button>`
        ).join('');
        const fechasEv = e.fechas && e.fechas.length ? e.fechas : [e.fecha ?? ''];
        const filasFechas = fechasEv.map((f) =>
          `<div class="fila-fecha flex items-center gap-2">
             <input type="date" name="fechas" value="${f}" class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
             <button type="button" class="btn-quitar-fecha rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-500 hover:bg-red-50 hover:text-red-600" title="Quitar fecha">✕</button>
           </div>`
        ).join('');

        cont.innerHTML = `
        <form id="form-evento" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5 max-w-2xl">
          <div class="flex flex-wrap gap-2">${indicador}</div>

          <section class="wiz-paso space-y-4" data-paso="1">
            <div>
              <label class="${etiqueta}">Título *</label>
              <input name="titulo" required value="${esc(e.titulo)}" class="${campo}" />
            </div>
            <div>
              <label class="${etiqueta}">Descripción</label>
              <textarea name="descripcion" rows="4" class="${campo}">${e.descripcion ?? ''}</textarea>
            </div>
            <div>
              <label class="${etiqueta}">Categoría</label>
              <select name="categoria_id" class="${campo}">
                <option value="">Sin categoría</option>${opts}
              </select>
            </div>
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input name="destacado" type="checkbox" ${e.destacado ? 'checked' : ''} class="w-4 h-4 accent-aguacero" />
              <span class="text-sm font-medium text-slate-700">⭐ Evento destacado</span>
            </label>
          </section>

          <section class="wiz-paso space-y-4" data-paso="2" style="display:none">
            <div>
              <label class="${etiqueta}">Fecha(s) del evento *</label>
              <div id="lista-fechas" class="space-y-2">${filasFechas}</div>
              <button type="button" id="btn-add-fecha"
                class="mt-2 rounded-xl border border-dashed border-slate-300 px-4 py-2 text-sm text-slate-600 hover:border-aguacero hover:text-aguacero transition-colors">
                ＋ Agregar otra fecha
              </button>
              <p class="text-xs text-slate-400 mt-1">Un evento puede tener varias fechas (ej: función viernes, sábado y domingo).</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="${etiqueta}">Hora de inicio *</label>
                <input name="hora" type="time" required value="${(e.hora ?? '').slice(0, 5)}" class="${campo}" />
              </div>
              <div>
                <label class="${etiqueta}">Hora de fin</label>
                <input name="hora_fin" type="time" value="${(e.hora_fin ?? '').slice(0, 5)}" class="${campo}" />
              </div>
              <div>
                <label class="${etiqueta}">Apertura de puertas</label>
                <input name="hora_apertura" type="time" value="${(e.hora_apertura ?? '').slice(0, 5)}" class="${campo}" />
              </div>
            </div>
          </section>

          <section class="wiz-paso space-y-4" data-paso="3" style="display:none">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="${etiqueta}">Lugar *</label>
                <input name="lugar" required value="${esc(e.lugar ?? '')}" class="${campo}" />
              </div>
              <div>
                <label class="${etiqueta}">Dirección</label>
                <input name="direccion" value="${esc(e.direccion ?? '')}" class="${campo}" />
              </div>
              <div>
                <label class="${etiqueta}">Precio</label>
                <input name="precio" value="${esc(e.precio ?? '')}" class="${campo}" />
              </div>
              <div>
                <label class="${etiqueta}">Organizador</label>
                <input name="organizador" value="${esc(e.organizador ?? '')}" class="${campo}" />
              </div>
              <div>
                <label class="${etiqueta}">Contacto (teléfonos, uno por línea)</label>
                <textarea name="contacto" rows="2" class="${campo}">${(e.contacto ?? []).join('\n')}</textarea>
              </div>
              <div>
                <label class="${etiqueta}">Correo de contacto</label>
                <input name="correo" type="email" value="${esc(e.correo ?? '')}" placeholder="organizador@ejemplo.cu" class="${campo}" />
              </div>
              <div class="md:col-span-2">
                <label class="${etiqueta}">Link web</label>
                <input name="link_web" type="url" value="${esc(e.link_web ?? '')}" class="${campo}" />
              </div>
            </div>
          </section>

          <section class="wiz-paso space-y-4" data-paso="4" style="display:none">
            <div>
              <label class="${etiqueta}">Imagen del flyer</label>
              <div class="flex flex-col sm:flex-row gap-3">
                <label class="flex-1 cursor-pointer">
                  <input id="input-archivo" type="file" accept="image/*" class="hidden" />
                  <span class="flex items-center justify-center gap-2 w-full rounded-xl border-2 border-dashed border-slate-300 hover:border-aguacero px-4 py-3 text-sm text-slate-600">
                    📤 <span id="nombre-archivo">Subir imagen…</span>
                  </span>
                </label>
                <input name="imagen" id="input-url" type="url" value="${esc(e.imagen ?? '')}" placeholder="…o pega una URL https://"
                  class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aguacero" />
              </div>
              <div id="preview-img" class="mt-2" style="${e.imagen ? '' : 'display:none'}">
                <img src="${esc(e.imagen ?? '')}" class="h-24 rounded-xl object-cover border border-slate-200" alt="Vista previa" />
              </div>
              <p id="estado-subida" class="text-xs text-slate-500 mt-1"></p>
            </div>
          </section>

          <section class="wiz-paso space-y-4" data-paso="5" style="display:none">
            <div id="resumen" class="rounded-xl bg-slate-50 border border-slate-200 p-4"></div>
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input name="publicado" type="checkbox" ${e.publicado ? 'checked' : ''} class="w-4 h-4 accent-emerald-500" />
              <span class="text-sm font-medium text-slate-700">🚀 Publicado <span class="text-xs text-slate-400">(visible en la APK)</span></span>
            </label>
          </section>

          <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-slate-100">
            <button type="button" id="btn-anterior"
              class="rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-50 text-slate-700">
              ← Atrás
            </button>
            <button type="button" id="btn-siguiente"
              class="rounded-xl bg-aguacero hover:bg-aguacero-oscuro text-white font-semibold px-6 py-2.5 text-sm transition-colors">
              Siguiente →
            </button>
            <button type="submit" id="btn-guardar" style="display:none"
              class="rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-2.5 text-sm transition-colors">
              💾 Guardar
            </button>
            <a href="${base}/"
              class="rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-50 text-slate-700">
              Cancelar
            </a>
          </div>
        </form>`;

        const form = document.getElementById('form-evento') as HTMLFormElement;
        inicializarWizard(form);

        // ---- Subida de imagen a Supabase Storage ----
        const inputArchivo = document.getElementById('input-archivo') as HTMLInputElement;
        const inputUrl = document.getElementById('input-url') as HTMLInputElement;
        inputArchivo?.addEventListener('change', async () => {
          const archivo = inputArchivo.files?.[0];
          if (!archivo) return;
          const nombreEl = document.getElementById('nombre-archivo') as HTMLElement;
          const estadoEl = document.getElementById('estado-subida') as HTMLElement;
          const previewEl = document.getElementById('preview-img') as HTMLElement;
          nombreEl.textContent = archivo.name;
          estadoEl.textContent = '⏳ Subiendo…';
          try {
            const ext = archivo.name.split('.').pop() || 'jpg';
            const nombre = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
            const { error } = await supabase.storage.from('flyers').upload(nombre, archivo);
            if (error) throw error;
            const { data } = supabase.storage.from('flyers').getPublicUrl(nombre);
            inputUrl.value = data.publicUrl;
            (previewEl.querySelector('img') as HTMLImageElement).src = data.publicUrl;
            previewEl.style.display = '';
            estadoEl.textContent = '✓ Imagen subida';
          } catch (err: any) {
            estadoEl.textContent = '✗ Error: ' + (err.message ?? err);
          }
        });

        form.addEventListener('submit', async (ev2) => {
          ev2.preventDefault();
          const fd = new FormData(form);
          const btn = document.getElementById('btn-guardar') as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = 'Guardando…';
          const contactoRaw = ((fd.get('contacto') as string) ?? '').split('\n').map((s) => s.trim()).filter(Boolean);
          const fechasRaw = fd.getAll('fechas').map((s) => (s as string).trim()).filter(Boolean).sort();

          const { error } = await supabase.from('eventos').update({
            titulo: fd.get('titulo'),
            descripcion: fd.get('descripcion') || '',
            fecha: fechasRaw[0],
            fechas: fechasRaw,
            hora: fd.get('hora'),
            hora_fin: ((fd.get('hora_fin') as string) || null) as any,
            hora_apertura: ((fd.get('hora_apertura') as string) || null) as any,
            lugar: fd.get('lugar'),
            direccion: fd.get('direccion') || '',
            precio: fd.get('precio') || '',
            contacto: contactoRaw,
            correo: ((fd.get('correo') as string) || null) as any,
            link_web: ((fd.get('link_web') as string) || null) as any,
            imagen: fd.get('imagen') || '',
            categoria_id: ((fd.get('categoria_id') as string) || null) as any,
            organizador: fd.get('organizador') || '',
            destacado: (form.querySelector('[name="destacado"]') as HTMLInputElement).checked,
            publicado: (form.querySelector('[name="publicado"]') as HTMLInputElement).checked,
          }).eq('id', id);

          if (error) {
            (window as any).toast('Error: ' + error.message, 'error');
            btn.disabled = false;
            btn.textContent = '💾 Guardar';
          } else {
            (window as any).toast('Evento actualizado ✓');
            setTimeout(() => (window.location.href = `${base}/`), 800);
          }
        });
      }
    }
  </script>
</Base>
